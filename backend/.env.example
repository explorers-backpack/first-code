# CareerAI 后端环境变量样例
# ---------------------------------------------------------------
# 用法：复制本文件为 backend/.env，填入真实值。
#   cp backend/.env.example backend/.env
#
# 注意：
# - 本文件（.env.example）会被提交到 git，**只放变量名，禁止填写真实凭据**；
# - backend/.env 已被 .gitignore 忽略，真实凭据只写在那里；
# - 代码只通过 os.getenv() 读取这些变量，源码中不得硬编码任何密钥。
# ---------------------------------------------------------------

# 数据库连接串 —— 项目唯一正式数据库（MySQL 8 + 异步驱动 aiomysql）
# 格式：mysql+aiomysql://<user>:<password>@<host>:<port>/<db>?charset=utf8mb4
# 若密码包含 @ : / ? # 等特殊字符，需做 URL 编码（percent-encoding）。
# 缺失该变量时后端会直接抛出 RuntimeError 并拒绝启动，不会回退到其它数据库。
DATABASE_URL=mysql+aiomysql://<user>:<password>@<host>:3306/<db>?charset=utf8mb4

# ---------------------------------------------------------------
# 讯飞星火 —— **文本大模型 X1** 的凭据（仅后端调用；前端不得持有任何 API Secret）
# ---------------------------------------------------------------
# 讯飞把「文本大模型 X1」与「Embedding」当两个服务卖，**同一个 AppId 未必都开通**
# （实测：有的 AppId 只通 X1、有的只通 Embedding）。因此本项目有两组变量：
#   · SPARK_*            → 文本模型（AI 出题 / AI 简历诊断，见 main.SparkAPI）
#   · SPARK_EMBEDDING_*  → Embedding（RAG 向量化，见下方「讯飞星火专用」小节）
# Embedding 优先读专用组，**三项都取不到时逐项回落 SPARK_***
# ⇒ 若某个 AppId 两项服务都开通了，只填下面这三行即可（回落生效）。
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=

# ---------------------------------------------------------------
# 真实 Embedding（RAG 知识库向量化）—— 可选
# ---------------------------------------------------------------
# 全部注释掉，是为了让「复制本文件得到 .env」时**保持离线默认**：
# 一个变量都不配 → 使用离线哈希占位实现（不联网、不需要密钥、测试与离线开发照常）。
# 详见 backend/services/embedding_provider.py 的模块文档（配置表 + 异常映射表）。
#
# ★ 回归套件不受本配置影响：backend/tests/embedding_env.py 会在 import 期把
#   EMBEDDING_PROVIDER / EMBEDDING_API_KEY 钉成空串（等价「未配置」⇒ 离线占位），
#   因此即便 .env 里启用了真实 Embedding，跑 backend/tests/test_*.py 依旧是
#   离线、确定、不消耗上游配额的。需要真实模型的**联网运行器**（tests/*_run.py，
#   不带 test_ 前缀、不进回归循环）**不要**导入它。
#
# 两种真实协议二选一（都配了就按 EMBEDDING_PROVIDER 取值走）：
#   openai —— OpenAI 兼容的 POST {EMBEDDING_BASE_URL}/embeddings + Bearer 密钥
#   spark  —— 讯飞星火 Embedding（另一套协议：HMAC 签名在 query string、
#             请求体是 header/parameter/payload、响应是 base64 的小端 float32）
# 详见 backend/services/embedding_provider_spark.py 的模块文档。
#
# EMBEDDING_PROVIDER=openai        # hash（离线占位，默认）/ mock（测试替身）/
#                                  # openai（OpenAI 兼容）/ spark（讯飞星火）
#                                  # 留空时自动：配了 EMBEDDING_API_KEY → openai，否则 → hash
#                                  # ★ spark **必须显式写**：只配 SPARK_* 不会自动切换，
#                                  #   否则「只给文本模型配了凭据」的部署会悄悄改变检索行为。
# EMBEDDING_API_KEY=               # 密钥只填在 .env 里，禁止提交（本文件会被提交）
# EMBEDDING_BASE_URL=https://api.openai.com/v1   # 不含 /embeddings；OpenAI 兼容服务均可
#                                  # 用 spark 时可省略（默认 https://emb-cn-huabei-1.xf-yun.com/）
# EMBEDDING_MODEL=text-embedding-3-small         # 写进 knowledge_chunk.embedding_model
#                                  # 用 spark 时默认 xinghuo-embedding（★ 与 openai 的模型名
#                                  # 必须不同：入库靠它判断「旧向量是否由当前模型产生」）
# EMBEDDING_DIMENSION=0            # 0 = 不校验维度（按上游返回）
#                                  # 用 spark 时默认 2560（实测），建议保持声明值：
#                                  # 换模型 / 上游改协议会当场报维度不符，而不是悄悄检索不到
# EMBEDDING_TIMEOUT=30             # 单次请求超时（秒）
# EMBEDDING_BATCH_SIZE=16          # 单次请求最多几条文本
#                                  # ★ 对 spark **无效果**（上游只接受单条文本，只能逐条发）
#
# 讯飞星火专用（EMBEDDING_PROVIDER=spark 时必填；**优先**读下面这组专用凭据，
# 三项都取不到时**逐项回落**上面文本模型的 SPARK_*）
# SPARK_EMBEDDING_APP_ID=          # 可选：Embedding 专用 AppId（不填 → 回落 SPARK_APP_ID）
# SPARK_EMBEDDING_API_KEY=         # 可选：Embedding 专用 API Key（不填 → 回落 SPARK_API_KEY）
# SPARK_EMBEDDING_API_SECRET=      # 可选：Embedding 专用 API Secret（不填 → 回落 SPARK_API_SECRET）
# EMBEDDING_SPARK_DOMAIN=          # query / para；**一般不要设**——正常由用途决定：
#                                  # 写侧入库用 para（知识原文）、读侧检索用 query（用户问题）。
#                                  # 本变量只是排障用的逃生口。
#
# ★ 换 Embedding 模型后**必须重算旧向量**（不同模型的向量不可比）：
#   旧库向量是用旧模型算的，检索器按 embedding_model 过滤 ⇒ 不重算会表现为「一条都查不到」。
#   重算工具（**不重新切片、不改切片正文**，只重写向量三列）：
#       python scripts/migrate_embeddings.py --provider spark --dry-run   # 先看规模
#       python scripts/migrate_embeddings.py --provider spark --yes       # 真跑
#       python scripts/migrate_embeddings.py --provider spark --yes \
#           --retry-failed scripts/embedding_migration_stats.json         # 只补失败片
#   统计落在 scripts/embedding_migration_stats.json。
#   若同时换了**维度**且在用 chroma 后端，加 --reset-index（HNSW 只支持单一维度）。

# ---------------------------------------------------------------
# 向量后端（RAG 知识库检索）—— 可选
# ---------------------------------------------------------------
# 全部注释掉，是为了让「复制本文件得到 .env」时**保持默认后端**：
# 不设 VECTOR_STORE → 使用 vector_store_sql（无 ANN、全表扫描 + Python 侧余弦，
# 适合几千条以内；不需要额外依赖）。
# 想启用真实 ANN 索引：安装 chromadb（pip install chromadb），
# 再把下面 VECTOR_STORE 那行的注释去掉。
# 两个后端的排序口径与 score 口径完全一致，差别只在「召回」：ANN 是近似的。
# 详见 backend/services/vector_store_chroma.py 的模块文档（选型对比 + 架构说明）。
#
# VECTOR_STORE=sql                 # sql（默认，无 ANN）/ chroma（真实 HNSW ANN）
# CHROMA_PATH=                     # ANN 索引目录；留空用 backend/data/chroma（已被 gitignore）

# ---------------------------------------------------------------
# RAG 检索参数（读侧默认值）—— 可选
# ---------------------------------------------------------------
# 默认「全部注释掉」⇒ 复制本文件得到 .env 时**保持默认检索行为**：
# 不设 RAG_TOP_K → 用检索器自身默认（5 条）；
# 不设 RAG_MIN_SCORE / RAG_MIN_SCORE_RATIO → 不过滤（低分 chunk 也会进入 knowledge_context）。
#
# 作用位置：services/knowledge_rag.py 的 resolve_retriever_defaults()，
# 由 build_vector_retriever() 当作**默认值**——调用方显式传入的同名参数**优先覆盖**。
# 即：最终参数 = { **环境变量默认值, **调用方显式传入 }。
#
# ★★ 动手调参**之前**，先确认进程跑在真实语义模型上：
#   GET /api/health → {"status":"ok","service":...,"embedding":{...}}
#   embedding.semantic_enabled 必须是 **true**。
#   若为 false ⇒ 当前是 HashEmbeddingService（hash-local，词面哈希、**无语义**），
#   此时任何 min_score / top_k 都是在噪声上标定，数值没有参考价值。
#   排查顺序：EMBEDDING_PROVIDER 是否配对、凭据是否齐全（缺凭据会走 openai 分支并报错，
#   embedding.error 里能看到具体原因）。启动日志也会打印同一份状态（非语义时带 [WARN]）。
#
# ★ 推荐的生产取值（**真实 Embedding 下重新标定**）：
#   RAG_TOP_K=8 / RAG_MIN_SCORE=0.7685 / RAG_MIN_SCORE_RATIO=0.9947
#   —— 即下面三行；**刻意保持注释状态**，原因有二：
#   ① 本项目约定「不配 = 默认 = 行为不变」，模板不应在复制时悄悄改变行为；
#   ② 这三个数都与 Embedding 模型 + 语料绑定，**不能照抄别处的数字**。
#
# ★★ 为什么需要**两个**阈值（任务 80/81 的核心结论）
# ---------------------------------------------------------------
# 余弦分数的**绝对尺度会随 query 形态漂移**：实测同一个模型 + 同一份语料，
#   长问句 query（"MySQL 索引"）        top1 ≈ 0.83~0.85
#   岗位技能短词（"Python"/"MySQL"）    top1 ≈ 0.77
# 而生产真实 query 恰好是后者（current_topic(plan, context) → plan.priority_topics
# → job.skills 切分出的短技能词）。⇒ **单一绝对阈值不可能同时适配两种形态**：
#   为长问句标定的 0.83，对真实短词 query **命中 0**（RAG 等于关闭）。
#
# 因此拆成两把尺子（**AND** 关系）：
#   RAG_MIN_SCORE        绝对下限 —— 「语料到底有没有这个主题」
#   RAG_MIN_SCORE_RATIO  相对阈值 α —— 「同一次检索里，谁比最好的那个差太多」
#                        要求 score >= α × top1（top1 = 本次检索最高分，尺度无关）
#   生效阈值 = max(RAG_MIN_SCORE, α × top1)
#
#   标定方法（可复现，见 tests/rag_production_query_calibration_spark_run.py）：
#     python tests/rag_production_query_calibration_spark_run.py   # 联网，产分数地形 + 可行 α 区间
#   实测（22 篇 / 32 片 / 2560 维）：
#     短词 top1：Python 0.766315 / MySQL 0.770028 / Redis 0.776644
#     可行 α 交集 = (0.993246, 0.996251] ⇒ 取中点 0.9947
#     绝对下限 0.7685 夹在「未覆盖主题最高 top1」(0.766315) 与「已覆盖主题最低
#     top1」(0.770028) 之间 ⇒ 语料没覆盖的主题注入 0 条，而不是硬凑无关片段。
#     效果：Python → 0 条（正确）；MySQL → 2 条 mysql/index；Redis → 3 条 redis/*。
#
#   取值域：RAG_MIN_SCORE ∈ [-1, 1]（余弦）；RAG_MIN_SCORE_RATIO ∈ (0, 1]
#   （**比例**，不要写百分数：0.9947 而不是 99.47）。写错会被直接拦下报错。
#   **换语料 / 换 Embedding 模型后必须重新标定。**
#
# ★★ 阈值过期守卫 + 一键重标定（任务 88）
# ---------------------------------------------------------------
# 「换模型 / 改语料后必须重标定」以前只写在文档里、靠人记；而漏掉它的表现是
# **静默的**（一条都检索不到，或注入一堆噪声）。现在它是一个**可核对的产物**：
#
#   scripts/rag_threshold_provenance.json   ← 记录「这套阈值是对着什么标的」：
#       embedder.{provider,dimension} · corpus.{file,sha256,documents,chunks}
#       · params.{top_k,min_score,min_score_ratio} · windows（可行区间）
#
# 启动日志与 GET /api/health 的 threshold 字段会拿它与**当前实际**逐项比对：
#   status=ok       三者（模型 / 语料 / 配置）都对得上
#   status=stale    有明确过期理由（换过模型、改过语料、或 .env 被手工改过）
#   status=unknown  没有产物 / 产物坏了 ⇒ **无法判定**（不等于没问题！）
# 过期时的启动日志会直接给出补救命令。
#
# 重标定两步（第 ① 步联网、消耗少量配额；第 ② 步纯本地）：
#     python tests/rag_production_query_calibration_spark_run.py   # ① 重跑标定
#     python scripts/apply_threshold_calibration.py                # ② 先看计划（DRY-RUN）
#     python scripts/apply_threshold_calibration.py --yes          # ③ 写回 .env + 登记溯源
#
# ★ ② 是「修复」不是「改配置」：**现有值仍落在可行区间内就保留**。
#   所以在健康的库上跑它，.env 一个字节都不会变（只会补上/刷新溯源产物）。
#
#      ★ RAG_TOP_K 不是可有可无：真实模型下 top_k 会重新变成有效杠杆；
#        且实测 top_k ≤ 5 会**丢掉排序靠后的目标片**（某场景目标排在第 6~8 名）。
#
# 另注：这三个变量只在**本次请求真的检索**时才生效。生产 HTTP 入口
# POST /api/interview/{session_id}/next-question 与
# POST /api/interview/{session_id}/follow-up 的请求体 ``use_rag`` **默认开启**
# （缺省即检索；显式传 false 才关闭，此时这些变量不生效）。
# 面试开始接口 /start **仍走纯规则出题**，不检索知识库。
#
# RAG_TOP_K=8                      # 推荐值：检索候选条数；正整数（不设 = 5）
# RAG_MIN_SCORE=0.7685             # 推荐值：**绝对下限**（真实 Embedding）；不设 = 不过滤
# RAG_MIN_SCORE_RATIO=0.9947       # 推荐值：**相对阈值 α**（比例，(0,1]）；不设 = 关闭


# ===============================================================
# 数字人视频面试（interview_mode=avatar）· Avatar Provider
# ===============================================================
# 分层：interview_service → avatar_interview（通道层）→ AvatarProvider（接口）
#        → MockAvatarProvider（默认，离线） / IflytekAvatarProvider（真实，HTTP）
#
# ★★ 默认行为：**一个 AVATAR_* 都不配 ⇒ 通道走 Mock**（离线、确定性、不产生
#    任何真实音视频）。这与 EMBEDDING_PROVIDER 的「不配 = 默认 = 行为不变」同口径：
#    未开通数字人时，avatar 模式的面试流程**照常跑完**（交付内容与 text 逐字段一致）。
#
# ★★ 降级（重要）：provider 解析失败 / 网络失败 / 上游业务错误，一律被通道层
#    捕获并**降级为纯文本交付**——数字人故障**绝不允许阻断面试**。
#
# ---- 1) 选实现 ----
#   空 / mock   → MockAvatarProvider（默认）
#   iflytek     → IflytekAvatarProvider（**显式 opt-in**，需下面三项凭据）
#   其它取值    → 启动即报错（报错不静默，不悄悄回落到 Mock）
#
# AVATAR_PROVIDER=mock
#
# ---- 2) 讯飞虚拟人凭据（★ 需在讯飞控制台**单独开通「AI 虚拟人」**，与 Spark 大模型
#         的凭据不是同一套；下面的值是**占位符**，请替换为真实凭据） ----
#
# AVATAR_IFLYTEK_APP_ID=your_avatar_app_id
# AVATAR_IFLYTEK_API_KEY=your_avatar_api_key
# AVATAR_IFLYTEK_API_SECRET=your_avatar_api_secret
#
# ---- 3) 端点（★ 占位：以官方文档为准，改这里即可，不必改代码） ----
#
# AVATAR_IFLYTEK_HOST=avatar.cn-huabei-1.xf-yun.com
# AVATAR_IFLYTEK_BASE_PATH=/v1/avatar
#
# ---- 4) 形象 / 发音人（可选；也可在创建会话时按会话覆盖） ----
#
# AVATAR_IFLYTEK_AVATAR_ID=
# AVATAR_IFLYTEK_VCN=
#
# ---- 5) 单次请求超时（秒；正整数，不设 = 15） ----
#
# AVATAR_TIMEOUT=15
#
# 核对当前实际在用的 provider / 配置是否齐全（**纯读、不联网、不抛异常**）：
#     GET /api/health  →  avatar 字段（provider / configured / host / error）
# 接入说明详见 docs/数字人Provider接入说明.md。


# ===============================================================
# 数字人面试实时通道 · 生产化保护（WebSocket：/api/interview/{id}/ws）
# ===============================================================
# 全部旋钮都是**可选的**，且「不配 = 默认 = 行为不变」；非法值**启动即报错**（不静默回落）。
# 启动日志会打印一行 [production] 汇总当前生效值；
# 运行时读数在 GET /api/health → metrics 字段（活跃连接 / 跟踪会话 / 超时与淘汰计数）。
#
# ---- 1) 空闲超时（秒）----
#    超时即由**服务端主动关闭**，释放该连接占用的进程内资源。
#    它清掉的是「拔网线 / 进程被杀 / 浏览器崩溃」这类**不会发 FIN** 的半开连接；
#    前端有心跳（interviewSocket.js 每 25s 发一次 ping），活着的连接**不会**被误杀。
#    默认 300（5 分钟）。
#
# INTERVIEW_WS_IDLE_TIMEOUT=300
#
# ---- 2) 会话清理 ----
#    编排状态与「会话活跃记录」都是**进程内**的（不落库），必须有 TTL 与容量上限，
#    否则长时间运行会无界增长。清理是**机会式**的：每次有新连接建立时顺手做一次
#    （不引入后台定时任务 ⇒ 不引入新的启动顺序依赖）。
#    默认 TTL 21600（6 小时）、最多跟踪 2000 条会话。
#
# INTERVIEW_STATE_TTL=21600
# INTERVIEW_MAX_TRACKED_SESSIONS=2000
#
# ---- 3) 并发闸门（每用户）----
#    同时打开的 WS 连接数 / 面试会话数上限；超限的新连接会被**拒绝**（关闭码 4409）。
#    默认 4 条连接、3 个会话。
#
# INTERVIEW_MAX_WS_CONNECTIONS=4
# INTERVIEW_MAX_SESSIONS_PER_USER=3
#
# ---- 4) 作答限流（秒）----
#    ★ 默认 **0 = 不限制**（不配即行为不变）：最小间隔会改变**正常作答节奏**的判定，
#      因此必须显式开启。生产建议 0.4 ~ 1.0（真人不可能在 0.4 秒内说完一段回答）。
#      开启后，过快的提交会被拒为 answer(rejected)，并计入 metrics。
#
# INTERVIEW_ANSWER_MIN_INTERVAL=0

