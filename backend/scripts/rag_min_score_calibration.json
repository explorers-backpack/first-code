{
  "name": "rag-min-score-calibration",
  "version": 1,
  "purpose": "把任务 69 实测的 min_score 安全窗口落地为可用的标定值，并用任务 70（R1）的 retriever_kwargs 透传路径实跑验证：注入条数 15 → 5、Prompt 13810 → 9852 字。只做标定与验证，不修改生产代码、不改基准文件、不评价生成质量。",
  "scope": {
    "modifies_code": false,
    "modifies_benchmark": false,
    "evaluates_quality": false,
    "llm": "Mock（SpySpark + 场景 mock_reply）",
    "why_mock": "要测的量（注入条数 / Prompt 字符数）由检索 + 模板渲染决定，与模型输出无关；真实星火输出不确定。已用真实星火跑出的 rag_baseline.json 逐场景交叉核对 Prompt 字符数。"
  },
  "sources": {
    "benchmark": "backend/scripts/interview_eval_benchmark.json",
    "corpus": "backend/scripts/interview_knowledge.json",
    "no_rag_baseline": "backend/scripts/no_rag_baseline.json",
    "rag_baseline": "backend/scripts/rag_baseline.json",
    "task69_analysis": "backend/scripts/rag_param_analysis.json"
  },
  "calibration_basis": {
    "window_rule": "窗口 = (非目标来源最高分, 目标来源最低分]；min_score 取值须落在此区间内才既能保住目标、又剔除噪声",
    "window_measured_over": "全量候选（top_k=100 / min_score=None）",
    "inclusivity": "检索保留 score >= min_score ⇒ 下界开、上界闭",
    "recommended_value_rule": "取窗口中点（两侧余量对称，容忍度最大）",
    "robustness_tiers": {
      "wide": ">= 0.15",
      "narrow": ">= 0.05",
      "fragile": "< 0.05"
    },
    "usable_gap_threshold": 0.02,
    "embedder": "default_embedder()（hash-local，词面哈希 ⇒ 分数只在同模型内可比）",
    "corpus_chunks": 32
  },
  "passthrough_path": {
    "entry": "interview_core.generate_next_question(db, session_id, retriever=None, use_rag=True, retriever_kwargs={...})",
    "assembly": "resolve_retriever(db, None, True, retriever_kwargs=...) -> knowledge_rag.build_vector_retriever(db, **kwargs)",
    "added_by": "任务 70 · R1",
    "note": "retriever_kwargs 只在 use_rag=True 的组装分支生效；显式注入 retriever 时不被读取"
  },
