  "findings": [
    {
      "id": "F1",
      "title": "min_score 被绕过：声明的阈值没有生效",
      "evidence": {
        "effective_min_score": null,
        "declared_min_score": {
          "s1-mysql-index-mid": 0.25,
          "s2-spring-boot-senior": 0.25,
          "s3-cache-consistency-senior": 0.4
        },
        "why": "有 RAG 臂走 use_rag=True ⇒ resolve_retriever → build_vector_retriever(db) 不传任何 retriever_kwargs ⇒ min_score 取默认 None"
      }
    },
    {
      "id": "F2",
      "title": "top_k=5 是唯一约束 ⇒ 无论相关与否都恰好注入 5 条",
      "evidence": {
        "top_k": 5,
        "chunks_per_scenario": [
          5,
          5,
          5
        ],
        "corpus_chunks_in_store": 32
      }
    },
    {
      "id": "F3",
      "title": "低相关 chunk 占比约三分之二，且两种口径结论一致",
      "evidence": {
        "total_chunks": 15,
        "low_relevance_chunks": 10,
        "ratio": 0.6667,
        "per_scenario_ratio": [
          0.6,
          0.6,
          0.8
        ],
        "two_definitions_agree": true
      }
    },
    {
      "id": "F4",
      "title": "分数呈「头重脚轻」：目标 chunk 集中在头部，尾部骤降",
      "evidence": {
        "target_floor": {
          "s1-mysql-index-mid": 0.377964,
