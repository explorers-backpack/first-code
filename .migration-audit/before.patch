+def _observe_rag(action: str, session_id: int, data: Any, use_rag: bool) -> None:
+    """把「这次 RAG 到底发生了什么」落进日志（**只观察，不改任何返回值**）。
+
+    为什么需要它：检索失败被 core 按既定约定**吞掉**并当成正常返回值返回
+    （``ok`` 不受影响、只在 ``warnings`` 里记一条码），因此 ``_run`` 的
+    ``except`` 永远碰不到它 ⇒ 此前**向量库挂了在日志里一条记录都没有**，
+    面试题会一路在无知识状态下生成而无人察觉。
+
+    这里用 :func:`services.rag_diagnostics.classify_rag_outcome` 把
+    ``(use_rag, knowledge_chunks, warnings)`` 判成四态，并按严重程度分级：
+
+    - ``failed``   → ``WARNING``（★ 唯一的告警态：知识本该进来却没进来）
+    - ``empty``    → ``INFO``（链路正常但零命中，值得知道，不是故障）
+    - 其余（``off`` / ``injected``）→ ``DEBUG``（正常路径，不污染生产日志）
+
+    **刻意不抛异常**：可观测性绝不能反过来影响面试主流程——判定失败只记一条
+    ``ERROR`` 日志（那说明我们自己的入参约定写错了，需要修代码）。
+    """
+    try:
+        diagnosis = classify_rag_outcome(
+            use_rag=use_rag,
+            knowledge_chunks=data.get("knowledge_chunks", 0) if isinstance(data, dict) else 0,
+            warnings=(data.get("warnings") or ()) if isinstance(data, dict) else (),
+        )
+    except Exception:  # noqa: BLE001 - 可观测性失败不得影响主流程
+        logger.error("%s：RAG 结果判定失败（入参约定不一致？）", action, exc_info=True)
+        return
+
+    level = (
+        logging.WARNING
+        if diagnosis["alert"]
+        else logging.INFO
+        if diagnosis["state"] == RAG_STATE_EMPTY
+        else logging.DEBUG
+    )
+    if not logger.isEnabledFor(level):
+        return
+    logger.log(
+        level,
+        "%s：%s %s session_id=%s use_rag=%s",
+        action,
+        describe_rag_outcome(diagnosis),
+        diagnosis["reason"],
+        session_id,
+        use_rag,
+        extra={
+            "rag_state": diagnosis["state"],
+            "rag_degraded": diagnosis["degraded"],
+            "rag_chunks": diagnosis["chunks"],
+            "rag_failure_code": diagnosis["failure_code"],
+            "interview_session_id": session_id,
+        },
+    )
+
+
 @router.post(
     "/create",
     response_model=SessionCreateResponse,
@@ -253,6 +313,8 @@ async def next_question(
             retriever_kwargs=retriever_kwargs or None,
